#!/usr/bin/env bash
#MISE description="Check release config if present"
#MISE sources=[".goreleaser.yml"]
set -uo pipefail

[ -f .goreleaser.yml ] || exit 0

out=$(goreleaser check 2>&1)
ec=$?
printf '%s\n' "$out"
[ "$ec" -eq 0 ] && exit 0

# brews (Formula) is deprecated upstream in favor of homebrew_casks, but
# used here intentionally: casks aren't code-signed and get flagged as
# malware by Gatekeeper. This exemption should move upstream to
# hugoh/go-tools if this becomes a recurring pattern across repos.
if [ "$ec" -eq 2 ] && printf '%s\n' "$out" | grep -q 'configuration is valid, but uses deprecated properties'; then
  exit 0
fi

exit "$ec"
